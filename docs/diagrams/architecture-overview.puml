@startuml
title ParametricCAD — component architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

package "Qt UI" {
    component MainWindow
    component FeatureEditorPanel
    component CadViewer
    component ModelPresenter
    component TransformGizmo
    component SnapManager
    component TransformMath
}

package "Application" {
    component ModelingController
    component ProjectController
    component VisibilityManager
    interface FeatureEditingService
}

package "Commands" {
    component QUndoStack
    component FeatureCommands
}

package "Parametric model" {
    component Body
    component ParametricFeature <<abstract>>
    component TopologicalReference
    component "SketchFeature\nlocal 2D entities / frame" as SketchFeature
    component "Primitive / profile features" as PrimitiveFeatures
    component "Operation features\nExtrude, Boolean, PushPull, ..." as OperationFeatures
    component SketchProfileBuilder
}

package "Geometry / OCCT" {
    component BasicFeatures
    component "TopoDS_Shape / B-Rep" as BRep
}

package "Persistence" {
    component ProjectFile
    component ".pcad JSON" as Pcad
}

package "Presentation state" {
    component SavedView
    component SpatialVisibilityRule
    component "Section clipping state" as SectionState
}

MainWindow --> ModelingController : modeling actions
MainWindow --> ProjectController : open / save / new
MainWindow --> FeatureEditorPanel : selection and descriptors
MainWindow --> CadViewer : presentation coordination
MainWindow --> ModelPresenter : bulk Open synchronization
MainWindow --> VisibilityManager : presentation policy/actions
ModelPresenter --> CadViewer : batched feature presentation
ModelPresenter --> Body : recompute / feature state
ModelPresenter --> VisibilityManager : visibility projection

FeatureEditorPanel ..> FeatureEditingService : uses contract
ModelingController ..|> FeatureEditingService

CadViewer --> MainWindow : feature IDs / PushPull commit
CadViewer --> TransformGizmo : display / hit-test handles
CadViewer --> SnapManager : snap candidates
CadViewer --> TransformMath : screen-to-world transforms
CadViewer --> SavedView : camera/presentation restore
CadViewer --> SpatialVisibilityRule : spatial box presentation
CadViewer --> SectionState : viewer clip plane

ModelingController --> QUndoStack : push / undo / redo
QUndoStack --> FeatureCommands
FeatureCommands --> Body : mutate through commands

Body *-- ParametricFeature
PrimitiveFeatures --|> ParametricFeature
OperationFeatures --|> ParametricFeature
OperationFeatures --> SketchProfileBuilder : Sketch profiles
SketchFeature --|> ParametricFeature
SketchFeature --> TopologicalReference : Face support

ParametricFeature --> BasicFeatures : build geometry
ParametricFeature --> TopologicalReference : stable subshape dependencies
TopologicalReference --> BRep : signature / resolution
BasicFeatures --> BRep

ProjectController --> ProjectFile
ProjectFile --> Body : validated load / save
ProjectFile --> VisibilityManager : groups / filters / presets
ProjectFile --> SavedView : saved views
ProjectFile --> Pcad

note right of CadViewer
  Visualization and interaction only.
  It does not own model history
  or QUndoStack.
end note

note right of Body
  Ordered feature history.
  Dependencies, dirty state,
  recompute and result shape.
end note

@enduml
